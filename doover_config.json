{
    "opcua_reader": {
        "name": "opcua_reader",
        "display_name": "OPCUA Reader",
        "type": "DEV",
        "visibility": "PUB",
        "allow_many": true,
        "description": "Read OPCUA values and create alarms based on those values",
        "long_description": "README.md",
        "depends_on": [],
        "image_name": "ghcr.io/spaneng/opcua-reader:master",
        "build_args": "--platform linux/arm64",
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
