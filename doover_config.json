{
    "opcua_reader": {
        "name": "opcua_reader",
        "display_name": "OPCUA Reader",
        "type": "DEV",
        "visibility": "PUB",
        "allow_many": true,
        "description": "Read OPCUA values and create alarms based on those values",
        "long_description": "README.md",
        "depends_on": [],
        "owner_org": "48f2d2c4-4c82-4fc3-8de8-d924d81c4588",
        "image_name": "ghcr.io/spaneng/opcua_reader:latest",
        "container_registry_profile": "70cd4b2b-505f-4028-ae1d-153c62a6e87b",
        "build_args": "--platform linux/amd64,linux/arm64",
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "Application Config",
            "type": "object",
            "properties": {
                "digital_input_count": {
                    "title": "Digital Input Count",
                    "x-name": "digital_input_count",
                    "x-hidden": false,
                    "type": "integer",
                    "default": "$device.digitalinputcount",
                    "minimum": 0
                },
                "digital_output_count": {
                    "title": "Digital Output Count",
                    "x-name": "digital_output_count",
                    "x-hidden": false,
                    "type": "integer",
                    "default": "$device.digitaloutputcount",
                    "minimum": 0
                },
                "digital_outputs_enabled": {
                    "title": "Digital Outputs Enabled",
                    "x-name": "digital_outputs_enabled",
                    "x-hidden": false,
                    "type": "boolean",
                    "default": true
                },
                "a_funny_message": {
                    "title": "A Funny Message",
                    "x-name": "a_funny_message",
                    "x-hidden": false,
                    "type": "string"
                },
                "simulator_app_key": {
                    "format": "doover-application",
                    "title": "Simulator App Key",
                    "x-name": "simulator_app_key",
                    "x-hidden": false,
                    "type": "string",
                    "description": "The app key for the simulator"
                }
            },
            "additionalElements": true,
            "required": [
                "a_funny_message",
                "simulator_app_key"
            ]
        }
    }
}