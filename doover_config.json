                                "title": "Data Type",
                                "x-name": "data_type",
                                "x-hidden": false,
                                "type": "string",
                                "description": "Data type of the OPC UA variable"
                            }
                        },
                        "additionalElements": false,
                        "required": [
                            "name_space_index",
                            "variable_name",
                            "data_type"
