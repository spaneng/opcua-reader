                "opcua_address": {
                    "title": "OPCUA Address",
                    "x-name": "opcua_address",
                    "x-hidden": false,
                    "type": "string",
                    "x-required": true,
                    "description": "OPC UA server URI, e.g. opc.tcp://localhost:4840/freeopcua/server/",
                    "x-position": 0
                },
                "opcua_server_values": {
                    "title": "OPCUA Server Values",
                    "x-name": "opcua_server_values",
                    "x-hidden": false,
                    "type": "array",
                    "x-required": true,
                    "x-position": 1,
                    "items": {
                        "title": "OPCUA Variable",
                        "x-name": "opcua_variable",
                        "x-hidden": false,
                        "type": "object",
                        "x-required": true,
                        "properties": {
                            "name_space_index": {
                                "title": "Name Space Index",
                                "x-name": "name_space_index",
                                "x-hidden": false,
                                "type": "string",
                                "x-required": true,
                                "description": "Name Space Index of the OPC UA variable",
                                "x-position": 1
                            },
                            "variable_name": {
                                "title": "Variable Name",
                                "x-name": "variable_name",
                                "x-hidden": false,
                                "type": "string",
                                "x-required": true,
                                "description": "Name of the OPC UA variable to read",
                                "x-position": 2
                            },
                            "sensor_object_name": {
                                "title": "Sensor Object Name",
                                "x-name": "sensor_object_name",
                                "x-hidden": false,
                                "type": "string",
                                "x-required": true,
                                "description": "Name of the sensor object in the OPC UA server",
                                "x-position": 3
                            },
                            "data_type": {
                                "enum": [
                                    "Int",
                                    "Float",
                                    "String",
                                    "Boolean"
