                                "title": "Data Type",
                                "x-name": "data_type",
                                "x-hidden": false,
                                "type": "string",
                                "x-required": true,
                                "description": "Data type of the OPC UA variable",
                                "x-position": 4
                            },
                            "units": {
                                "title": "Units",
                                "x-name": "units",
                                "x-hidden": false,
                                "type": [
                                    "string",
                                    "null"
                                ],
                                "x-required": false,
                                "description": "Unit of the OPC UA variable, e.g. '\u00b0C', 'V', 'm/s', etc",
                                "default": "",
                                "x-position": 5
                            },
                            "variable_alarms": {
                                "title": "Variable Alarms",
                                "x-name": "variable_alarms",
                                "x-hidden": false,
                                "type": "array",
                                "x-required": true,
                                "description": "Alarms associated with this OPC UA variable",
                                "x-position": 6,
                                "items": {
                                    "title": "Alarm",
                                    "x-name": "alarm",
                                    "x-hidden": false,
                                    "type": "object",
                                    "x-required": true,
                                    "properties": {
                                        "alarm_name": {
                                            "title": "Alarm Name",
                                            "x-name": "alarm_name",
                                            "x-hidden": false,
                                            "type": "string",
                                            "x-required": true,
                                            "description": "Name of the alarm",
                                            "x-position": 1
                                        },
                                        "alarm_condition": {
                                            "enum": [
                                                "High",
                                                "Low"
                                            ],
                                            "title": "Alarm Condition",
                                            "x-name": "alarm_condition",
                                            "x-hidden": false,
                                            "type": "string",
                                            "x-required": true,
                                            "description": "High: value greater than limit, Low: value less than limit",
                                            "x-position": 2
                                        },
                                        "minimum_alarm_value": {
                                            "title": "Minimum Alarm Value",
                                            "x-name": "minimum_alarm_value",
                                            "x-hidden": false,
                                            "type": [
                                                "number",
                                                "null"
                                            ],
                                            "x-required": false,
                                            "description": "Minimum value for the alarm to trigger",
                                            "default": 0.0,
                                            "x-position": 3
                                        },
                                        "maximum_alarm_value": {
                                            "title": "Maximum Alarm Value",
                                            "x-name": "maximum_alarm_value",
                                            "x-hidden": false,
                                            "type": [
                                                "number",
                                                "null"
                                            ],
                                            "x-required": false,
                                            "description": "Maximum value for the alarm to trigger",
                                            "default": 100.0,
                                            "x-position": 4
                                        },
                                        "grace_period_s": {
                                            "title": "Grace Period (s)",
                                            "x-name": "grace_period_s",
                                            "x-hidden": false,
                                            "type": [
                                                "number",
                                                "null"
                                            ],
                                            "x-required": false,
                                            "description": "Duration threshold has to be met before calling alarm",
                                            "default": 600.0,
                                            "x-position": 5
                                        }
                                    },
                                    "additionalElements": true,
                                    "required": [
                                        "alarm_name",
                                        "alarm_condition"
                                    ],
                                    "x-collapsible": true,
                                    "x-defaultCollapsed": false
                                }
                            }
                        },
                        "additionalElements": true,
                        "required": [
                            "name_space_index",
                            "variable_name",
                            "sensor_object_name",
                            "data_type",
                            "variable_alarms"
                        ],
                        "x-collapsible": true,
                        "x-defaultCollapsed": false
                    }
                }
            },
            "additionalElements": true,
            "required": [
                "opcua_address",
                "opcua_server_values"
            ]
        },
